# ============================================================================
# BLACKSENTINEL AI - Environment Configuration
# Copy to .env and fill in values
# ============================================================================

# Application
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Security (CHANGE IN PRODUCTION!)
JWT_SECRET=CHANGE_ME_TO_A_SECURE_32_CHARACTER_MINIMUM_SECRET_KEY
ENCRYPTION_KEY=CHANGE_ME_TO_A_SECURE_32_CHARACTER_MINIMUM_KEY

# Redis
REDIS_URL=redis://localhost:6379

# Neo4j
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=blacksentinel

# PostgreSQL
POSTGRES_URL=postgresql://bsadmin:blacksentinel@localhost:5432/blacksentinel

# Vector Database
VECTOR_DB_URL=http://localhost:8000

# Service URLs
AI_ENGINE_HOST=localhost
AI_ENGINE_PORT=8080
AGENT_ORCHESTRATOR_HOST=localhost
AGENT_ORCHESTRATOR_PORT=8081
KNOWLEDGE_GRAPH_HOST=localhost
KNOWLEDGE_GRAPH_PORT=8082
MEMORY_SERVICE_HOST=localhost
MEMORY_SERVICE_PORT=8083

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=1

# LLM Provider
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_API_KEY=your-api-key-here
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# Features
METRICS_ENABLED=true
TRACING_ENABLED=true
WEBSOCKET_ENABLED=true
