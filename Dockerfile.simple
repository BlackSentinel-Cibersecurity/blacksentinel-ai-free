FROM node:20-slim

WORKDIR /app

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

COPY package.json ./
COPY shared/ ./shared/
COPY src/ ./src/
COPY database/ ./database/
COPY tsconfig.json ./

RUN npm install
RUN npm install -g tsx

RUN groupadd --system aiengine && useradd --system --gid aiengine aiengine && \
    chown -R aiengine:aiengine /app

USER aiengine

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

CMD ["npx", "tsx", "--tsconfig", "tsconfig.json", "src/server/index.ts"]
